{
  "name": "Kiwalibooth — Digital Photobooth Studio",
  "short_name": "Kiwalibooth",
  "description": "Browser-based photobooth. No apps, no cloud, no accounts. Capture and save your own photobooth strips directly in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#FF6B81",
  "categories": ["photo", "entertainment", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
